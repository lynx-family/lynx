import("../config.gni")
import("../core/Lynx.gni")
import("../testing/test.gni")
import("service_api.gni")

# Consumers select this entry; registry ownership stays in the platform package.
if (is_ios) {
  import("//${lynx_dir}/build_overrides/darwin.gni")
  subspec_target("lynx_service_api") {
    output_name = "ServiceAPI"
    dependency = [ "LynxServiceAPI/Core" ]
  }
} else {
  group("lynx_service_api") {
    if (is_android) {
      public_deps = [
        "//${lynx_dir}/platform/android/service_api:lynx_service_api_native",
      ]
    } else if (is_harmony) {
      public_deps = [ "//${lynx_dir}/service_api:lynx_service_api_native" ]
    } else {
      public_deps = [ "//${lynx_dir}/service_api:src" ]
    }
  }
}

source_set("src") {
  sources = service_api_sources
  public = service_api_public
  if (enable_unittests) {
    defines = [ "TESTING=1" ]
  }
}

if (is_harmony) {
  shared_library("lynx_service_api_native") {
    output_name = "lynx_service_api"
    deps = [ "//${lynx_dir}/service_api:src" ]
    configs += [ "../platform/harmony/lynx_harmony:harmony_public_config" ]
  }
}

if (enable_unittests) {
  source_set("src_testset") {
    testonly = true
    sources = [
      "./testing/a/a_service.h",
      "./testing/b/b_service.h",
    ]
    deps = [ ":src" ]
    defines = [ "TESTING=1" ]
  }

  shared_library("lynx_service_api_native_testing") {
    testonly = true
    output_name = "lynx_service_api_ut"
    deps = [ ":src_testset" ]
  }
}
