    "cdp_event_listener_sender_harmony.cc",
    "cdp_event_listener_sender_harmony.h",
    "debug_bridge_harmony.cc",
    "debug_bridge_harmony.h",
    "devtool_env_harmony.cc",
    "devtool_env_harmony.h",
    "entry.cc",
    "env_embedder.cc",
    "harmony_input_event_target.cc",
    "harmony_input_event_target.h",
    "harmony_touch_event_injector.cc",
    "inspector_owner_embedder_harmony.cc",
    "inspector_owner_embedder_harmony.h",
    "inspector_owner_harmony.cc",
    "inspector_owner_harmony.h",
    "message_handler_harmony.cc",
    "message_handler_harmony.h",
  ]
  deps = [ "../../../../../../devtool/lynx_devtool/js_debug:rts_inspector_manager_factory_stub" ]

  if (enable_testbench_replay) {
    sources += [
      "fixture_replay_harmony.cc",
      "fixture_replay_harmony.h",
    ]
    deps += [
      "//third_party/modp_b64",
      "//third_party/zlib:minizip",
    ]
  }

  include_dirs =
      [ "../../../oh_modules/@lynx/debug_router/src/main/debug_router/include" ]
