import("../../../config.gni")
import("../../../core/Lynx.gni")
import("../../../devtool/lynx_devtool/devtool.gni")
import("../harmony.gni")

source_set("native") {
  public_deps = [ "src/main/cpp" ]
}

devtool_source_set("lynx_devtool_lib") {
  sources = [
    "../../../core/renderer/css/css_color.cc",
    "../../../core/renderer/css/css_color.h",
  ]

  include_dirs =
      [ "oh_modules/@lynx/debug_router/src/main/debug_router/include" ]

  deps = [
    ":native",
    "../../../core/build:build",
    "../../../core/renderer/css:css_keywords",
    "../../../devtool/embedder/core:lynx_devtool_embedder_core",
    "../../../devtool/lynx_devtool:lynx_devtool_group",
  ]

  deps += [
    # devtool doesn't contain implementation of log, only deps on base_log_headers here
    "../../../base/src:base_log_headers",
    "../../../devtool/base_devtool/common:base_devtool_common_sources",
    "../../../devtool/lynx_devtool/js_debug",
    "../../../devtool/lynx_devtool/tracing",
    "../../../third_party/jsoncpp:jsoncpp",
    "//third_party/modp_b64:modp_b64",
  ]
}

if (enable_harmony_shared) {
  lynx_devtool_type = "shared_library"
} else {
  lynx_devtool_type = "source_set"
}

target(lynx_devtool_type, "lynx_devtool") {
  output_name = "lynxdevtool"

  deps = [
    ":lynx_devtool_lib",
    "../../../base/platform/harmony:lynx_base",
    "../lynx_harmony",
  ]

  lib_dirs = [
    primjs_native_lib_dir,
    "oh_modules/@lynx/debug_router/libs/${harmony_app_abi}",
  ]
  if (defined(enable_rts_runtime) && enable_rts_runtime) {
    lib_dirs += [ "//third_party/rts/harmony" ]
  }
  libs = [
    "ace_napi.z",
    "debugrouter",
    "quick",
    "uv",
    "native_vsync",
    "ohpreferences",
  ]
}

if (defined(enable_rts_runtime) && enable_rts_runtime && is_debug) {
  shared_library("rts_debug_loader") {
    output_name = "lynxdevtool_rts_debug"

    sources = [
      "../../../devtool/lynx_devtool/js_debug/lepus/manager/rts_inspector_manager_factory_stub.cc",
      "../../../devtool/lynx_devtool/js_debug/lepus/manager/rts_inspector_manager_factory_stub_default.cc",
    ]

    lib_dirs = [
      primjs_native_lib_dir,
      "//third_party/rts/harmony",
    ]
    libs = [ "rvm" ]
  }
}
