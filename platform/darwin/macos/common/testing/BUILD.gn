import("../../../../../core/Lynx.gni")
import("../../../../../testing/test.gni")

# Keep tests separate from the production BUILD file so loading them does not
# also load the renderer's dependencies.
if (is_mac && enable_unittests) {
  unittest_set("vsync_monitor_macos_testset") {
    sources = [
      "../../../../embedder/vsync_monitor_fallback.cc",
      "../../../../embedder/vsync_monitor_fallback.h",
      "../../../../embedder/windowless/windowless_ui_task_runner_delegate.cc",
      "../../../../embedder/windowless/windowless_ui_task_runner_delegate.h",
      "../vsync_monitor_macos.h",
      "../vsync_monitor_macos.mm",
      "../vsync_monitor_macos_unittest.mm",
    ]
    deps = [
      "../../../../../base/src:base_group",
      "../../../../../core/base",
      "../../../../embedder:lynx_embedder_capi",
    ]
    frameworks = [
      "AppKit.framework",
      "QuartzCore.framework",
    ]
  }

  unittest_exec("vsync_monitor_macos_unittests_exec") {
    deps = [
      ":vsync_monitor_macos_testset",
      "../../../../../core/renderer/utils:lynx_env",
    ]
  }
}
