if (enable_unittests) {
  executable("lynx_embedder_unittests") {
    testonly = true
    include_dirs = [ "../../base/include/value" ]
    sources = [
      "lynx_env_unittests.cc",
      "lynx_group_unittests.cc",
      "lynx_load_meta_unittests.cc",
      "lynx_log_unittests.cc",
      "lynx_template_bundle_unittests.cc",
      "lynx_template_data_unittests.cc",
      "lynx_ui_renderer_unittests.cc",
      "lynx_update_meta_unittests.cc",
      "lynx_value_unittest.cc",
      "lynx_view_builder_unittests.cc",
      "lynx_view_client_unittests.cc",
      "lynx_view_event_simulation_proxy_unittest.cc",
      "native_view_contract_unittests.cc",
      "resource_provider_contract_unittests.cc",
    ]

    # The test host uses a desktop FML message loop for view initialization.
    if (is_mac || is_win || is_linux) {
      sources += [ "lynx_view_unittests.cc" ]
    }

    if (enable_napi_binding) {
      sources += [ "module/extension_module_factory_impl_unittest.cc" ]
    }

    deps = [
      ":embedder",
      ":lynx_embedder_cxxapi",
      "../../base/src:base_static",
      "../../core/template_bundle/template_codec/binary_encoder",
      "../../testing/utils:gtest_custom_init",
      "../../testing/utils:gtest_main",
      "../../third_party/aes",
      "./fetcher:fetcher_unittests",
      "./lynx_service:lynx_service_unittests",
    ]

    if (enable_inspector) {
      deps += [ "./lynx_devtool" ]
    }

    if (is_mac) {
      deps += [ "../darwin/macos/common/testing:vsync_monitor_macos_testset" ]
      frameworks = [
        "IOSurface.framework",
        "QuartzCore.framework",
        "AppKit.framework",
      ]
    }
  }
}
