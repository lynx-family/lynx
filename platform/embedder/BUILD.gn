import("../../clay/common/config.gni")
import("../../core/Lynx.gni")
import("../../testing/test.gni")

config("public_api") {
  include_dirs = [ "./public" ]
  defines = [
    "NAPI_DISABLE_CPP_EXCEPTIONS",
    "NAPI_DISABLE_CPP_RTTI",
  ]
}

config("engine_config") {
  include_dirs = [
    "../..",
    "../../base/include/value",
  ]
  defines = []
  if (is_win) {
    # enable dllexport for public APIs.
    defines += [ "lynx_EXPORTS" ]
    cflags = [
      "-Wno-vla-extension",
      "-Wno-vla-cxx-extension",
    ]
  }
  if (is_headless) {
    defines += [ "ENABLE_WINDOWLESS" ]
  }
}

config("rendering_config") {
  defines = [ "CLAY_LIBRARY_IMPLEMENTATION" ]
}

# Keep the existing config available to platform integrations while they move
# to the engine or rendering target. Engine-only targets must not use it.
config("config") {
  configs = [
    ":engine_config",
    ":rendering_config",
  ]
}

lynx_core_source_set("lynx_runtime_lifecycle_observer") {
  sources = [
    "lynx_runtime_lifecycle_observer.cc",
    "lynx_runtime_lifecycle_observer_priv.h",
  ]
  public_deps = [
    ":lynx_embedder_capi",
    ":lynx_napi_api",
    "../../base/src:base_public_headers",
    "../../core/runtime/js:js",
  ]
  public_configs = [ "../../third_party/weak-node-api:weak_node_api_config" ]
}

lynx_core_source_set("devtool_settings_embedder") {
  sources = [
    "devtool_settings_embedder.cc",
    "devtool_settings_embedder.h",
    "switch_persist.h",
  ]
  if (is_mac) {
    sources += [ "SwitchPersist.mm" ]
    frameworks = [ "Foundation.framework" ]
  } else if (is_win) {
    sources += [ "switch_persist_win.cc" ]
  } else {
    sources += [ "switch_persist.cc" ]
  }
  deps = [
    "../../base/src:base_public_headers",
    "../../core/renderer/utils:renderer_utils",
  ]
}

# Preserve the existing SDK entry point and public configuration. Implementations
# are linked exactly once through their owning target.
group("embedder") {
  public_deps = [
    ":engine",
    ":rendering",
  ]
  public_configs = [
    ":public_api",
    ":config",
  ]
}

# SDK-private declarations. Builder storage and concrete renderers are not part
# of this target. Factory contracts accept only an owned configuration snapshot.
lynx_core_source_set("contracts") {
  sources = [
    "interfaces/native_view.h",
    "interfaces/renderer_config.h",
    "interfaces/renderer_factory.h",
    "interfaces/resource_provider.h",
    "lynx_env_platform.h",
    "lynx_ui_renderer.h",
  ]
  public_deps = [
    ":lynx_embedder_capi",
    "../../base/src:base_public_headers",
    "../../core/public:public",
  ]
  public_configs = [
    ":public_api",
    ":engine_config",
  ]
  if (enable_napi_binding) {
    public_configs += [ "../../third_party/weak-node-api:weak_node_api_config" ]
  }
  assert_no_deps = [
    ":engine",
    ":rendering",
  ]
}

lynx_core_source_set("engine") {
  assert_no_deps = [
    ":clay_renderer",
    ":rendering",
    "../../clay/*",
    "./windowless:*",
  ]
  sources = [
    "lynx_env.cc",
    "lynx_env_priv.h",
    "lynx_group.cc",
    "lynx_group_priv.h",
    "lynx_load_meta.cc",
    "lynx_load_meta_priv.h",
    "lynx_log.cc",
    "lynx_native_view.cc",
    "lynx_template_bundle.cc",
    "lynx_template_bundle_priv.h",
    "lynx_template_data.cc",
    "lynx_template_data_priv.h",
    "lynx_trace.cc",
    "lynx_ui_renderer_factory.cc",
    "lynx_ui_renderer_factory.h",
    "lynx_update_meta.cc",
    "lynx_update_meta_priv.h",
    "lynx_view.cc",
    "lynx_view_builder.cc",
    "lynx_view_builder_priv.h",
    "lynx_view_client.cc",
    "lynx_view_client_priv.h",
    "lynx_view_clients.cc",
    "lynx_view_clients.h",
    "lynx_view_event_simulation_proxy.cc",
    "lynx_view_event_simulation_proxy.h",
    "lynx_view_priv.h",
    "lynx_vsync_monitor.cc",
    "lynx_vsync_monitor_priv.h",
    "memory/lynx_memory.cc",
  ]
  deps = [
    ":contracts",
    ":public_headers",
    "../../base/src:base_static",
    "../../base/trace/native:trace_public_headers",
    "../../core:lynx_native",
    "../../core/base:base",
    "../../core/renderer:tasm",
    "../../core/renderer/data",
    "../../core/renderer/utils:renderer_utils",
    "../../core/runtime/lepus:lepus",
    "../../core/shared_data:white_board",
    "../../core/shell:shell",
    "../../core/template_bundle:template_bundle",
    "../../core/value_wrapper:value_wrapper",
    "./core:renderer",
    "./fetcher",
    "./lynx_service",
    "./resource",
  ]
  if (enable_unittests) {
    sources += [
      "testing/lynx_ui_renderer_test.cc",
      "testing/lynx_ui_renderer_test.h",
    ]
    deps += [ "../../core/renderer/ui_wrapper/common" ]
  } else if (!is_mac && !is_win) {
    # Mobile and other non-desktop hosts have no platform window renderer.
    sources += [ "lynx_ui_renderer_mock.cc" ]
  }
  if (enable_napi_binding) {
    deps += [ "./module:base_module" ]
    public_deps = [
      ":lynx_runtime_lifecycle_observer",
      "../../third_party/napi:weak_node_api_host",
      "./module",
    ]
  }
  if (use_clay_lynx_trail_hub_impl) {
    deps += [ "./lynx_service:trail_hub_impl" ]
  }
  public_configs = [
    ":public_api",
    ":engine_config",
  ]

  if (is_mac) {
    sources += [ "lynx_env_macos.mm" ]
    if (!enable_unittests) {
      deps += [ "../darwin/macos/common:engine" ]
    }
  } else {
    sources += [ "lynx_env_default.cc" ]
  }
  if (is_win || is_mac) {
    sources += [
      "native_view/lynx_texture_view.cc",
      "native_view/lynx_texture_view.h",
    ]
  }
  if (is_headless) {
    sources += [ "windowless/windowless_ui_task_runner_delegate.cc" ]
  }

  if (enable_inspector && enable_logbox) {
    deps += [ "./lynx_devtool:lynx_devtool_logbox" ]
  }
  if (enable_inspector) {
    deps += [
      "../../devtool/embedder/common:lynx_devtool_embedder_common",
      "../../third_party/debug_router/src/debug_router/common:debug_router_source",
    ]
  }

  if (!enable_unittests && !is_android && !is_harmony) {
    if (!is_ios) {
      sources += [ "sysinfo_embedder.cc" ]
    }
    sources += [
      "vsync_monitor_fallback.cc",
      "vsync_monitor_fallback.h",
    ]
  }
  if (!enable_unittests && is_android && is_headless) {
    sources += [
      "vsync_monitor_fallback.cc",
      "vsync_monitor_fallback.h",
    ]
  }
  if (is_win) {
    sources += [ "../../core/renderer/utils/sys_lynx_env/sys_env_default.cc" ]
  }
}

# Clay-specific input behavior stays out of the generic renderer vtable so the
# Engine-owned mock can link without any Rendering implementation.
lynx_core_source_set("clay_renderer") {
  sources = [
    "lynx_ui_renderer_clay.cc",
    "lynx_ui_renderer_clay.h",
  ]
  deps = [ "../../base/src:base_static" ]
  public_deps = [ ":contracts" ]
  configs = [ ":rendering_config" ]
  assert_no_deps = [ ":engine" ]
}

# Renderer implementations consume only SDK-private contracts, never Builder
# storage, engine callback state, or the resource fetcher implementation.
lynx_core_source_set("rendering") {
  sources = [
    "frame_timing_listener_impl.cc",
    "frame_timing_listener_impl.h",
  ]
  deps = [ "../../base/src:base_static" ]
  public_deps = [
    ":clay_renderer",
    ":contracts",
    "../../clay/shell/common:frame_timing_listener",
  ]
  configs = [ ":rendering_config" ]
  if (is_headless) {
    deps += [ "./windowless" ]
  }

  if (is_mac && !enable_unittests) {
    deps += [ "../darwin/macos/common:rendering" ]
  }
  if ((enable_unittests || is_android || is_harmony) &&
      !(is_harmony && is_headless)) {
    deps += [ "../../clay/lynx_adaptor:native_platform_view_mock" ]
  }
  assert_no_deps = [
    ":engine",
    "./core/*",
    "./fetcher/*",
    "./module/*",
    "./resource/*",
  ]
}

group("public_headers") {
  public_deps = [
    ":lynx_embedder_capi",
    ":lynx_embedder_cxxapi",
    ":lynx_napi_api",
    ":lynx_value_api",
  ]
}

