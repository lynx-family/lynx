copy("lynx_value_api") {
  sources = [
    "../../base/include/value/lynx_api_types.h",
    "../../base/include/value/lynx_value_api.h",
    "../../base/include/value/lynx_value_types.h",
  ]
  outputs =
      [ "$root_build_dir/include/base/include/value/{{source_file_part}}" ]
}

copy("lynx_napi_api") {
  sources = [
    "../../third_party/weak-node-api/headers/js_native_api.h",
    "../../third_party/weak-node-api/headers/js_native_api_types.h",
    "../../third_party/weak-node-api/headers/napi-inl.deprecated.h",
    "../../third_party/weak-node-api/headers/napi-inl.h",
    "../../third_party/weak-node-api/headers/napi.h",
    "../../third_party/weak-node-api/headers/node_api.h",
    "../../third_party/weak-node-api/headers/node_api_types.h",
    "../../third_party/weak-node-api/headers/weak_napi_defines.h",
