import os
import platform


system = platform.system().lower()
machine = platform.machine().lower()
machine = "x86_64" if machine == "amd64" else machine

SPARKLING_NODE_VERSION = "22.16.0"
SPARKLING_PNPM_VERSION = "10.26.0"
SPARKLING_BUILDTOOLS_PATH = os.path.join(root_dir, "buildtools", "sparkling")
SPARKLING_NODE_PATH = os.path.join(
    SPARKLING_BUILDTOOLS_PATH, "node", "bin", "node"
)
SPARKLING_PNPM_PATH = os.path.join(
    SPARKLING_BUILDTOOLS_PATH, "corepack", "pnpm"
)
if system == "windows":
    SPARKLING_NODE_PATH = os.path.join(
        SPARKLING_BUILDTOOLS_PATH, "node", "node.exe"
    )


def symlink_sparkling_tool(source, target):
    source = os.path.relpath(source, os.path.dirname(target))
    if os.path.islink(target) and os.readlink(target) == source:
        return
    if os.path.exists(target) or os.path.islink(target):
        os.remove(target)
    os.makedirs(os.path.dirname(target), exist_ok=True)
    os.symlink(source, target)


def prepare_sparkling_pnpm_shim():
    pnpm_script_path = os.path.join(
        SPARKLING_PNPM_PATH, SPARKLING_PNPM_VERSION, "bin", "pnpm.cjs"
    )
    if system == "windows":
        pnpm_shim_path = os.path.join(SPARKLING_PNPM_PATH, "pnpm.cmd")
        with open(pnpm_shim_path, "w", encoding="utf-8") as f:
            f.write("@echo off\n")
            f.write(f'"{SPARKLING_NODE_PATH}" "{pnpm_script_path}" %*\n')
    else:
        symlink_sparkling_tool(
            pnpm_script_path, os.path.join(SPARKLING_PNPM_PATH, "pnpm")
        )


deps = {
    "buildtools/sparkling/node": {
        "type": "http",
        "url": {
            "linux-x86_64": f"https://nodejs.org/dist/v{SPARKLING_NODE_VERSION}/node-v{SPARKLING_NODE_VERSION}-linux-x64.tar.gz",
            "linux-arm64": f"https://nodejs.org/dist/v{SPARKLING_NODE_VERSION}/node-v{SPARKLING_NODE_VERSION}-linux-arm64.tar.gz",
            "darwin-x86_64": f"https://nodejs.org/dist/v{SPARKLING_NODE_VERSION}/node-v{SPARKLING_NODE_VERSION}-darwin-x64.tar.gz",
            "darwin-arm64": f"https://nodejs.org/dist/v{SPARKLING_NODE_VERSION}/node-v{SPARKLING_NODE_VERSION}-darwin-arm64.tar.gz",
            "windows-x86_64": f"https://nodejs.org/dist/v{SPARKLING_NODE_VERSION}/node-v{SPARKLING_NODE_VERSION}-win-x64.zip",
        }.get(f"{system}-{machine}", None),
        "sha256": {
            "linux-x86_64": "fb870226119d47378fa9c92c4535389c72dae14fcc7b47e6fdcc82c43de5a547",
            "linux-arm64": "1725602e9fb150eb8b8220a899085190e1c04d1a5f3862b01c3dc1dfce0157f9",
            "darwin-x86_64": "838d400f7e66c804e5d11e2ecb61d6e9e878611146baff69d6a2def3cc23f4ac",
            "darwin-arm64": "1d7f34ec4c03e12d8b33481e5c4560432d7dc31a0ef3ff5a4d9a8ada7cf6ecc9",
            "windows-x86_64": "21c2d9735c80b8f86dab19305aa6a9f6f59bbc808f68de3eef09d5832e3bfbbd",
        }.get(f"{system}-{machine}", None),
        "ignore_in_git": True,
        "condition": system in ["linux", "darwin", "windows"],
    },
    f"buildtools/sparkling/corepack/pnpm/{SPARKLING_PNPM_VERSION}": {
        "type": "http",
        "url": f"https://registry.npmjs.org/pnpm/-/pnpm-{SPARKLING_PNPM_VERSION}.tgz",
        "sha256": "f60974c68cfe0a13f951fba0199669588577f0e3f0c9b7d1a7ca47633bf72386",
        "ignore_in_git": True,
    },
    "prepare_sparkling_pnpm_shim": {
        "type": "action",
        "cwd": root_dir,
        "function": prepare_sparkling_pnpm_shim,
        "require": [
            "buildtools/sparkling/node",
            f"buildtools/sparkling/corepack/pnpm/{SPARKLING_PNPM_VERSION}",
        ],
    },
}
