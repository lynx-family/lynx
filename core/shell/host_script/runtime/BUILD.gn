import("../../../../testing/test.gni")
import("../../../Lynx.gni")

lynx_core_source_set("host_script") {
  sources = [
    "../lynx_view/lynx_view_ref_proxy.h",
    "../lynx_view/lynx_view_ref_types.h",
    "host_script_interceptor.cc",
    "host_script_interceptor.h",
    "host_script_js_dispatcher.cc",
    "host_script_js_dispatcher.h",
    "host_script_module.cc",
    "host_script_module.h",
    "host_script_session.cc",
    "host_script_session.h",
    "interceptor.cc",
    "interceptor.h",
  ]

  public_deps = [ "../../../../base/src:base_values" ]
  deps = [
    "../../../../third_party/binding/napi:napi_binding_base",
    "../../../build",
    "../../../runtime/common/napi:napi_binding_core",
  ]
}

# BTS native module interception, installed into each module manager.
lynx_core_source_set("jsb_interceptor") {
  sources = [
    "host_script_module_interceptor.cc",
    "host_script_module_interceptor.h",
    "host_script_value_snapshot.cc",
    "host_script_value_snapshot.h",
  ]
  deps = [
    ":host_script",
    "../../../runtime/js:js",
    "../../../runtime/js/jsi",
    "../../../value_wrapper:value_wrapper",
  ]
}

lynx_core_source_set("process_runtime") {
  sources = [
    "host_script_thread_bindings.cc",
    "host_script_thread_bindings.h",
    "process_runtime.cc",
    "process_runtime.h",
  ]
  deps = [
    "../../../../base/src:base_log_headers",
    "../../../runtime/js:js",
  ]
}

if (enable_unittests) {
  # The interceptor needs no platform macro, so it is also tested on hosts.
  if (enable_napi_binding &&
      (is_mac || is_linux || is_win || (is_android && lynx_in_debug))) {
    unittest_exec("host_script_module_interceptor_unittests_exec") {
      sources = [ "host_script_module_interceptor_unittest.cc" ]
      deps = [
        ":host_script",
        ":jsb_interceptor",
        "../../../inspector:inspector",
        "../../../renderer/dom:dom",
        "../../../runtime",
      ]
      if (enable_testbench_recorder) {
        deps += [
          "../../../../base/src:base_group",
          "../../../services/recorder:recorder",
        ]
      }
    }
  }
  host_script_test_deps = [
    ":host_script",
    "../../../../third_party/napi:quickjs",
    "../../../../third_party/quickjs",
    "../../../runtime/common/napi:napi_binding_quickjs",
    "//third_party/googletest:gtest",
  ]

  unittest_set("host_script_session_unittests_testset") {
    sources = [ "host_script_session_unittest.cc" ]
    deps = host_script_test_deps
  }

  if (is_mac || is_linux || is_win) {
    unittest_exec("process_runtime_unittests_exec") {
      sources = [
        "../../../renderer/tasm/config.cc",
        "../../../renderer/tasm/sysinfo/sysinfo_default.cc",
        "../../../renderer/tasm/testing/event_tracker_mock.cc",
        "process_runtime_unittest.cc",
      ]
      deps = [
        ":process_runtime",
        "../../../../third_party/napi:env",
        "../../../../third_party/napi:quickjs",
        "../../../../third_party/quickjs",
        "../../../runtime/common/napi:napi_binding_quickjs",
        "../../../services/performance",
        "//third_party/googletest:gtest",
      ]
      if (is_mac) {
        deps += [ "../../../runtime/common/napi:napi_binding_jsc" ]
        ldflags = [ "-Wl,-dead_strip" ]
      } else {
        deps += [ "../../../runtime/js/jsi/quickjs:quickjs" ]
      }
    }

    unittest_exec("host_script_session_unittests_exec") {
      sources = [ "host_script_session_unittest.cc" ]
      deps = host_script_test_deps
      if (is_mac) {
        ldflags = [ "-Wl,-undefined,dynamic_lookup" ]
      } else {
        deps += [ "../../../runtime/js/jsi/quickjs:quickjs" ]
      }
    }
  }
}
