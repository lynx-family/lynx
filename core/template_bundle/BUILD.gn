import("//${lynx_dir}/build_overrides/codec_files.gni")
import("../Lynx.gni")

# constant_share_sources

lynx_core_source_set("template_bundle") {
  deps = [ "lynxml:lynxml_parser" ]

  sources = [
    "lynx_template_bundle.cc",
    "lynx_template_bundle.h",
  ]

  public_deps = [
    "../devtool_wrapper:devtool_wrapper",
    "template_codec:template_decoder",
  ]
}

lynx_core_source_set("template_bundle_converter") {
  # The shared implementation (compiler options / BTS / custom sections /
  # top-level `Convert...` entry point) lives in `_impl.cc` so the OSS and
  # internal builds do not have to keep two copies in sync. Only
  # `SerializeMTSBundle` is swapped via `template_bundle_converter_sources`.
  sources = [
              "lynx_template_bundle_converter.h",
              "lynx_template_bundle_converter_impl.cc",
            ] + template_bundle_converter_sources
  public_deps = [ ":template_bundle" ]
}
