import("../../../testing/test.gni")
import("../../Lynx.gni")

lynx_core_source_set("lynxml_parser") {
  sources = [
    "lynxml_parser.cc",
    "lynxml_parser.h",
    "lynxml_source_observer.cc",
    "lynxml_source_observer.h",
  ]
}

lynx_core_source_set("lynxml_style_parser") {
  sources = [
    "lynxml_style_parser.cc",
    "lynxml_style_parser.h",
  ]
  public_deps = [ "../template_codec:template_decoder" ]

  # Oliver compiles the CSS sources directly into encoder_common. Depending on
  # the CSS target as well would link those sources twice.
  if (is_oliver) {
    check_includes = false
  } else {
    public_deps += [ "../../renderer/css:css" ]
  }
}

unittest_set("lynxml_parser_testset") {
  sources = [
    "lynxml_parser_unittest.cc",
    "lynxml_source_observer_unittest.cc",
  ]
  public_deps = [ ":lynxml_parser" ]
}

unittest_exec("lynxml_parser_unittest_exec") {
  sources = []
  deps = [ ":lynxml_parser_testset" ]
}
