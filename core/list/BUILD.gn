import("../../testing/test.gni")
import("../Lynx.gni")

list_container_base_shared_sources = [
  "decoupled_list_types.h",
  "list_container_delegate.h",
  "list_element_delegate.h",
  "list_item_element_delegate.h",
]

if (disable_list_platform_implementation) {
  list_container_base_shared_sources += [
    "animation/animation_manager.h",
    "animation/animation_target.h",
    "animation/animation_types.h",
    "decoupled_adapter_helper.cc",
    "decoupled_adapter_helper.h",
    "decoupled_batch_list_adapter.cc",
    "decoupled_batch_list_adapter.h",
    "decoupled_default_list_adapter.cc",
    "decoupled_default_list_adapter.h",
    "decoupled_grid_layout_manager.cc",
    "decoupled_grid_layout_manager.h",
    "decoupled_item_holder.cc",
    "decoupled_item_holder.h",
    "decoupled_linear_layout_manager.cc",
    "decoupled_linear_layout_manager.h",
    "decoupled_list_adapter.cc",
    "decoupled_list_adapter.h",
    "decoupled_list_anchor_manager.cc",
    "decoupled_list_anchor_manager.h",
    "decoupled_list_children_helper.cc",
    "decoupled_list_children_helper.h",
    "decoupled_list_container_impl.cc",
    "decoupled_list_container_impl.h",
    "decoupled_list_event_manager.cc",
    "decoupled_list_event_manager.h",
    "decoupled_list_layout_manager.cc",
    "decoupled_list_layout_manager.h",
    "decoupled_list_orientation_helper.cc",
    "decoupled_list_orientation_helper.h",
    "decoupled_list_types.h",
    "decoupled_staggered_grid_layout_manager.cc",
    "decoupled_staggered_grid_layout_manager.h",
    "list_animation_manager.cc",
    "list_animation_manager.h",
  ]
  list_container_base_shared_sources += [
    "animation/animation_manager_default.cc",
    "animation/animation_manager_default.h",
    "list_animation_manager_default.cc",
    "list_animation_manager_default.h",
  ]
} else {
  list_container_base_shared_sources += [ "decoupled_list_container_default.h" ]
}

# Shared container implementation with no dependency on the animation backend.
lynx_core_source_set("list_container_base") {
  sources = list_container_base_shared_sources
  public_deps = [
    "../build:build",
    "../renderer/trace:renderer_trace",
  ]
}

# Adds real update animation managers and the animated container factory.
lynx_core_source_set("list_container") {
  sources = [ "decoupled_list_container_factory.h" ]
  public_deps = [ ":list_container_base" ]
  if (disable_list_platform_implementation) {
    sources += [
      "animation/animation_manager_impl.cc",
      "animation/animation_manager_impl.h",
      "animation/animation_transaction.cc",
      "animation/animation_transaction.h",
      "animation/item_animation_recorder.cc",
      "animation/item_animation_recorder.h",
      "animation/item_animator.cc",
      "animation/item_animator.h",
      "animation/item_animator_base.cc",
      "animation/item_animator_base.h",
      "animation/item_animator_default.cc",
      "animation/item_animator_default.h",
      "decoupled_list_container_factory_impl.cc",
      "list_animation_manager_impl.cc",
      "list_animation_manager_impl.h",
    ]
    deps = [ "../animation/lynx_basic_animator:lynx_basic_animator" ]
  } else {
    sources += [ "decoupled_list_container_factory_default.cc" ]
  }
}

list_container_testset_shared_sources = []

if (disable_list_platform_implementation) {
  list_container_testset_shared_sources += [
    "decoupled_default_list_adapter_unittest.cc",
    "decoupled_list_adapter_unittest.cc",
    "decoupled_list_anchor_manager_unittest.cc",
    "decoupled_list_children_helper_unittest.cc",
    "decoupled_list_container_impl_unittest.cc",
    "decoupled_list_event_manager_unittest.cc",
    "decoupled_list_layout_manager_unittest.cc",
    "decoupled_list_orientation_helper_unittest.cc",
    "decoupled_staggered_grid_layout_manager_unittest.cc",
    "testing/fiber_diff_info.h",
    "testing/mock_list_element.h",
    "testing/radon_data_source.h",
    "testing/utils.h",
  ]
  list_container_testset_shared_sources += [
    "animation/animation_manager_impl_unittest.cc",
    "animation/animation_transaction_unittest.cc",
    "animation/animation_types_unittest.cc",
    "animation/item_animation_recorder_unittest.cc",
    "animation/item_animator_base_unittest.cc",
    "animation/item_animator_default_unittest.cc",
    "animation/item_animator_unittest.cc",
    "testing/mock_animation_manager.h",
    "testing/mock_animation_target.h",
    "testing/mock_item_animator.h",
    "testing/mock_vsync_monitor.h",
  ]
}

unittest_set("list_container_testset") {
  sources = list_container_testset_shared_sources
  public_deps = [ ":list_container" ]
  deps = [
    "../base",
    "../public",
    "../renderer/dom:dom",
  ]
}

unittest_exec("list_container_testset_exec") {
  sources = []
  deps = [ ":list_container_testset" ]
}

group("list_container_testset_group") {
  testonly = true
  deps = [
    ":list_container_testset",
    ":list_container_testset_exec",
  ]
}
