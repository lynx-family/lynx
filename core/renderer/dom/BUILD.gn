import("../../../testing/test.gni")
import("../../Lynx.gni")
import("build.gni")

# This exists to break some cycle dependencies with :dom source_set
lynx_core_source_set("dom_headers") {
  check_includes = false
  sources = [
    "element.h",
    "element_manager.h",
    "element_manager_delegate.h",
    "element_property.h",
  ]
}

lynx_core_source_set("dom") {
  sources = lynx_dom_core_sources_path + lynx_element_shared_sources_path
  public_deps = [
    ":dom_headers",
    ":renderer_dom",
    "../:tasm",
    "../../../third_party/rapidjson",
    "../../runtime/lepus/bindings:bindings",
    "../../services/long_task_timing",
    "../../value_wrapper",
    "../css:css_dom",
    "../simple_styling",
    "../trace:renderer_trace",
    "../ui_wrapper",
    "../utils:renderer_dom_utils",
    "../utils:renderer_utils",
    "fiber",
    "fragment",
    "//${lynx_dir}/core/services/ssr",
  ]

  if (!is_oliver_ssr) {
    public_deps += [ "selector:element_selector" ]
  }

  if (is_android) {
    public_deps += [ "../tasm/react/android/mapbuffer:map_buffer" ]
  }

  if (enable_unittests) {
    public_deps += [ "../css:css_decoder" ]
    defines = [ "ENABLE_UNITTESTS" ]
  }
  if (enable_lepusng_worklet) {
    public_deps += [ "../worklet:worklet" ]
  }
}

lynx_core_source_set("renderer_dom") {
  include_dirs = [ "../../../third_party" ]

  sources = lynx_renderer_dom_sources_path + lynx_component_attr_sources_path

  public_deps = [
    "../../base",
    "../../runtime/lepus:lepus",
    "../css",
    "../events",
    "../simple_styling",
    "../utils:renderer_dom_utils",
    "../utils:renderer_utils",
  ]
}

group("dom_tests") {
  testonly = true
  deps = [
    ":dom_unittest_exec",
    "fragment:fragment_test_exec",
  ]
  public_deps = [ ":dom_testset" ]
}

unittest_set("dom_testset") {
  public_configs = [ "../../:lynx_public_config" ]
  sources = [
    "../css/layout_node_unittest.cc",
    "../css/select_element_token_unittest.cc",
    "../utils/base/tasm_worker_task_runner_unittest.cc",
    "fragment/fragment_unittest.cc",
    "testing/attribute_holder_unittest.cc",
    "testing/block_element_unittest.cc",
    "testing/element_container_unittest.cc",
    "testing/element_context_delegate_unittest.cc",
    "testing/element_manager_unittest.cc",
    "testing/element_unittest.cc",
    "testing/element_vsync_proxy_unittest.cc",
    "testing/fiber_element_animation_variable_unittest.cc",
    "testing/fiber_element_css_selector_unittest.cc",
    "testing/fiber_element_dynamic_style_unittest.cc",
    "testing/fiber_element_inline_wrapper_unittest.cc",
    "testing/fiber_element_misc_unittest.cc",
    "testing/fiber_element_test.cc",
    "testing/fiber_element_test.h",
    "testing/fiber_element_tree_layout_unittest.cc",
    "testing/fiber_element_unittest.cc",
    "testing/fiber_mock_painting_context.cc",
    "testing/fiber_mock_painting_context.h",
    "testing/fiber_mock_text_layout.cc",
    "testing/fiber_mock_text_layout.h",
    "testing/fiber_new_fixed_test.cc",
    "testing/fiber_node_info_unittest.cc",
    "testing/list_element_unittest.cc",
    "testing/list_item_scheduler_adapter_unittest.cc",
    "testing/pseudo_element_unittest.cc",
    "testing/raw_text_element_unittest.cc",
    "testing/scroll_element_unittest.cc",
    "testing/style_resolver_unittest.cc",
    "testing/text_element_unittest.cc",
    "vdom/radon/radon_node_unittest.cc",
  ]
  deps = [
    "../../runtime/lepus/tasks:tasks_testset",
    "../../shell/testing:mock_tasm_delegate_testset",
    "../../template_bundle/template_codec/binary_encoder/css_encoder:css_encoder",
  ]
  public_deps = [ ":dom" ]
}

unittest_exec("dom_unittest_exec") {
  sources = []
  deps = [ ":dom_testset" ]
}
