import("../../../../config.gni")
import("../../../../testing/test.gni")

unittest_set("lepusng_debugger_testset") {
  public_configs = [ "../../../../core:lynx_public_config" ]
  sources = [
    "lepusng_debugger_integration_unittest.cc",
    "lepusng_debugger_unittest.cc",
  ]

  # lepus_debug brings in the real LepusNG debugger implementation; the
  # core lepus/shell targets provide the runtime and bytecode generator so
  # integration tests can create a real VM.
  public_deps = [
    "../:lepus_debug",
    "../../../../core/renderer:tasm",
    "../../../../core/renderer/dom:dom",
    "../../../../core/renderer/dom:renderer_dom",
    "../../../../core/renderer/starlight:starlight",
    "../../../../core/runtime/lepus:lepus",
    "../../../../core/runtime/lepus/bindings:bindings",
    "../../../../core/shell:shell",
    "../../../../third_party/quickjs",
    "../../../../third_party/rapidjson",
    "../../quickjs:quickjs_debug",
  ]
  include_dirs = [ "../../../../../third_party/googletest/googletest/include" ]
  public_configs += [ "../../../../third_party/quickjs:quickjs_public_config" ]
}

unittest_exec("lepusng_debugger_unittest_exec") {
  sources = []
  deps = [ ":lepusng_debugger_testset" ]
}
