import("../../../config.gni")

source_set("base_devtool_common_sources") {
  sources = [
    "devtool_global_slot_common.cc",
    "devtool_global_slot_common.h",
    "devtool_slot_common.cc",
    "devtool_slot_common.h",
  ]

  if (is_harmony) {
