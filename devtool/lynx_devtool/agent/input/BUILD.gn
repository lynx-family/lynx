import("../../../../testing/test.gni")
import("../../devtool.gni")

devtool_source_set("input_types") {
  sources = [
    "input_event.h",
    "input_event_target.h",
  ]
}

devtool_source_set("input") {
  sources = [
    "input_event.cc",
    "synthetic_gesture.cc",
    "synthetic_gesture.h",
  ]

  public_deps = [
    ":input_types",
    "../../../../core/base:vsync_monitor_headers",
  ]
}

unittest_set("input_testset") {
  sources = [ "synthetic_gesture_unittest.cc" ]
  public_deps = [ ":input" ]
}

unittest_exec("input_unittests_exec") {
  sources = []
  deps = [
    ":input_testset",
    "../../../../core/base:base",
    "../../../../core/renderer/utils:lynx_env",
  ]
}
