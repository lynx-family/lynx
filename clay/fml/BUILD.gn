import("fml.gni")

config("fml_config") {
  # to be deleted if clay opensourced
  include_dirs = [ "../../" ]
}

source_set("fml") {
  sources = fml_common_shared_sources

  if (is_mac || is_ios || is_tvos) {
    sources += fml_darwin_shared_sources
  } else if (is_win) {
    sources += fml_windows_shared_sources
  }

  sources += fml_backtrace_sources

  public_configs = [ ":fml_config" ]
  public_deps = [
    ":command_line",
    ":file_util",
    ":fml_log",
    ":string_conversion",
  ]
  deps = []

  libs = []

  if (is_ios || is_mac || is_tvos) {
    fml_cflags_objc_arc = [
      "-Werror=overriding-method-mismatch",
      "-Werror=undeclared-selector",
      "-fobjc-arc",
    ]
    fml_cflags_objcc_arc = fml_cflags_objc_arc

    cflags_objc = fml_cflags_objc_arc
    cflags_objcc = fml_cflags_objcc_arc

    frameworks = [ "Foundation.framework" ]
  }

  if (is_android) {
    libs += [ "android" ]
  }

  if (is_win) {
    # For wstring_conversion. See issue #50053.
    defines = [ "_SILENCE_CXX17_CODECVT_HEADER_DEPRECATION_WARNING" ]
  }
}

source_set("command_line") {
  sources = [
    "command_line.cc",
    "command_line.h",
  ]
  public_configs = [ ":fml_config" ]
  if (is_win) {
    public_deps = [ "../../base/src:base_public_headers" ]
  }
}

source_set("string_conversion") {
  sources = fml_string_conversion_sources

  # Current versions of libcxx have deprecated some of the UTF-16 string
  # conversion APIs.
  defines = [ "_LIBCPP_DISABLE_DEPRECATION_WARNINGS" ]

  if (is_win) {
    # TODO(cbracken): https://github.com/flutter/flutter/issues/50053
    defines += [ "_SILENCE_CXX17_CODECVT_HEADER_DEPRECATION_WARNING" ]

    # Base64 checks and UTF conversion use Base implementations. Inherit their
    # Windows export configuration instead of importing them from a DLL.
    deps = [ "../../base/src:base_group" ]
  }

  public_configs = [ ":fml_config" ]
}

source_set("icu_util") {
  sources = fml_icu_util_sources

  public_deps = [
    ":file_util",

    # These need to be in sync with the Fuchsia buildroot.
    "//third_party/icu",
  ]
  public_configs = [
    ":fml_config",
    "//third_party/icu:icu_config",
  ]
}

source_set("fml_log") {
  sources = fml_log_sources
  public_configs = [ ":fml_config" ]
}

source_set("file_util") {
  sources = fml_file_sources
  public_deps = [ ":native_library_util" ]
  public_configs = [ ":fml_config" ]
  if (is_ios || is_mac || is_tvos) {
    fml_cflags_objc = [
      "-Werror=overriding-method-mismatch",
      "-Werror=undeclared-selector",
    ]
    fml_cflags_objcc = fml_cflags_objc

    cflags_objc = fml_cflags_objc
    cflags_objcc = fml_cflags_objcc

    frameworks = [ "Foundation.framework" ]
  }
  if (is_win) {
    public_deps += [
      ":command_line",
      ":string_conversion",
      "../../base/src:base_group",
    ]
  }
}

if (is_win) {
  config("sdk_consumer") {
    # Core configs define lynx_EXPORTS transitively. An SDK consumer must import
    # both functions and data from lynx.dll, especially the log-level globals.
    cflags = [ "/Ulynx_EXPORTS" ]
  }

  source_set("string_conversion_for_sdk_consumer") {
    sources = fml_string_conversion_sources
    configs += [ ":sdk_consumer" ]
    defines = [
      "_LIBCPP_DISABLE_DEPRECATION_WARNINGS",
      "_SILENCE_CXX17_CODECVT_HEADER_DEPRECATION_WARNING",
    ]
    public_configs = [ ":fml_config" ]
    deps = [
      "../../base/src:base_public_headers",
      "../../base/src:string_conversion_win",
    ]
  }

  # Compile the same IO code for applications without changing its DLL-side
  # export semantics. Unit tests use file_util and link base directly.
  source_set("file_util_for_sdk_consumer") {
    sources = fml_file_sources + fml_native_library_sources
    configs += [ ":sdk_consumer" ]
    public_configs = [ ":fml_config" ]
    public_deps = [
      ":command_line",
      ":string_conversion_for_sdk_consumer",
      "../../base/src:base_public_headers",
      "../../base/src:unique_fd_win",
    ]
  }
}

source_set("native_library_util") {
  sources = fml_native_library_sources
  public_configs = [ ":fml_config" ]
  if (is_win) {
    public_deps = [
      ":string_conversion",
      "../../base/src:base_public_headers",
    ]
  }
}
