import("//build/toolchain/clang.gni")
import("../../../../clay/shell/config.gni")
import("../../../../clay/shell/gpu/gpu.gni")
import("../../../../core/Lynx.gni")

source_set("headless") {
  sources = [
    "clay_event_loop.cc",
    "clay_event_loop.h",
    "clay_headless_engine.cc",
    "clay_headless_engine.h",
    "clay_headless_renderer.cc",
    "clay_headless_renderer.h",
  ]

  deps = [
    "../../../common",
    "../../../common/graphics",
    "../../../flow",
    "../../../fml:fml",
    "../../../fml:icu_util",
    "../../../gfx/shared_image",
    "../../../ui:ui",
    "../../common:common",
    "../embedder:embedder",
  ]

  if (is_win || is_linux || is_mac) {
    deps += [ "../../../../gfx:gfx" ]
  }

  if (is_linux && enable_skity) {
    deps += [
      "../common/desktop/codec",
      "../common/desktop/svg",
    ]
  }

  # The iOS shell GPU configuration supports Metal and software only.
  if (shell_enable_gl && !is_ios) {
    sources += [
      "gl/clay_headless_renderer_gl.cc",
      "gl/clay_headless_renderer_gl.h",
      "gl/clay_headless_renderer_host_gl.cc",
      "gl/clay_headless_renderer_host_gl.h",
    ]

    deps += [ "../../gpu:gpu_surface_gl" ]

    if (is_mac) {
      sources += [
        "gl/clay_headless_renderer_cgl.cc",
        "gl/clay_headless_renderer_cgl.h",
      ]
    }

    if (is_win) {
      sources += [
        "gl/clay_headless_renderer_angle.cc",
        "gl/clay_headless_renderer_angle.h",
      ]

      configs += [ "//third_party/angle:gl_prototypes" ]

      if (clay_force_d3d9) {
        defines += [ "CLAY_FORCE_D3D9" ]
      }

      deps += [
        "//third_party/angle:libEGL_static",  # the order of libEGL_static and
                                              # libGLESv2_static is
                                              # important.. if
                                              # reversed, will cause a linker
                                              # error
                                              # DllMain already defined in
                                              # LIBCMTD.lib
        "//third_party/angle:libGLESv2_static",
      ]
    }

    if (is_linux && !(enable_software_rendering && enable_skity)) {
      sources += [
        "gl/clay_headless_renderer_epoxy.cc",
        "gl/clay_headless_renderer_epoxy.h",
      ]
    }

    if (enable_skity && enable_software_rendering &&
        (is_mac || is_win || is_linux)) {
      import("//third_party/angle/gni/angle.gni")
      assert(angle_enable_vulkan && angle_enable_swiftshader,
             "Skity software rendering requires ANGLE Vulkan and SwiftShader.")
      sources += [
        "gl/clay_headless_renderer_swiftshader.cc",
        "gl/clay_headless_renderer_swiftshader.h",
      ]
      if (!is_win) {
        configs += [ "//third_party/angle:gl_prototypes" ]
        deps += [
          "//third_party/angle:libEGL_static",
          "//third_party/angle:libGLESv2_static",
        ]
      }
      deps += [ "//third_party/angle:includes" ]
      data_deps = [
        "//third_party/swiftshader:swiftshader",
        "//third_party/vulkan-deps/vulkan-loader/src:libvulkan",
      ]
    }

    if (is_harmony || is_android) {
      sources += [
        "gl/clay_headless_renderer_gles.cc",
        "gl/clay_headless_renderer_gles.h",
      ]
    }
  }

  if (shell_enable_metal) {
    sources += [
      "metal/clay_headless_renderer_metal.h",
      "metal/clay_headless_renderer_metal.mm",
    ]
  }

  public_configs = [
    "../../../../clay:config",
    ":headless_config",
  ]
}

config("headless_config") {
  defines = []

  defines += [ "CLAY_LIBRARY_IMPLEMENTATION" ]

  if (is_win) {
    defines += [ "lynx_EXPORTS" ]
    cflags = [ "-Wno-c99-designator" ]
  }
}

# Requires the SwiftShader runtime beside the test executable.
if (is_headless && enable_skity && enable_software_rendering &&
    shell_enable_gl && (is_mac || is_win)) {
  executable("swiftshader_software_unittests") {
    testonly = true
    sources = [ "gl/clay_headless_renderer_swiftshader_unittests.cc" ]
    if (!enable_clay_standalone) {
      sources += [ "../common/desktop/codec/desktop_image_codec_service.cc" ]
    }
    configs += [
      "../../../../clay:config",
      "../embedder:embedder_gpu_configuration_config",
      "//third_party/angle:gl_prototypes",
    ]
    deps = [
      ":headless",
      "../../../../base/src:base_static",
      "../../../../base/trace/native:trace",
      "../common/desktop/codec",
      "../common/desktop/svg",
      "//third_party/angle:includes",
      "//third_party/googletest:gtest_main",
    ]
    if (is_win) {
      import("//build/config/win/win.gni")
      configs += [ "//third_party/angle:angle_static" ]
      deps += [
        "../../common:platform_overlay_service_fallback",
        "../../common:presenter_service_fallback",
      ]
      if (!enable_clay_standalone) {
        sources += [
          "../../../ui/platform/common/native_view_service_common.cc",
          "../../common/services/initialize_service.cc",
        ]
      }
      if (use_flutter_cxx) {
        runtime_lib = "msvcprt"
        if (windows_runtime_library_mode == "mt") {
          runtime_lib = "libcpmt"
        }
        if (is_debug) {
          runtime_lib += "d"
        }
        libs = [ "$runtime_lib.lib" ]
      }
    }
    if (is_mac) {
      # Keep the test's static libc++ symbols private when loading Vulkan.
      ldflags = [
        "-Wl,-dead_strip",
        "-Wl,-exported_symbol,_main",
      ]
      frameworks = [
        "AppKit.framework",
        "CoreText.framework",
        "CoreGraphics.framework",
        "Metal.framework",
        "CoreVideo.framework",
        "IOKit.framework",
      ]
    }
  }
}
