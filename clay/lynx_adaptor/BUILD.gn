import("../common/config.gni")
import("./native_module/build.gni")

if (enable_unittests) {
  static_library("get_text_info_unittest_support") {
    testonly = true
    sources = [
      "clay_value.cc",
      "native_module/lynx_text_info_module.cc",
      "painting_context_clay.cc",
      "perf_controller_clay.cc",
      "prop_bundle_impl.cc",
      "value_converter.cc",
    ]

    public_configs = [
      "../../clay:config",
      "../../core:lynx_public_config",
      "../../platform/embedder:public_api",
    ]

    public_deps = [
      "../fml:fml",
      "../ui:ui",
    ]

    defines = []
    if (is_mac || is_android || is_ios) {
      defines += [ "TRACE_EVENT_HIDE_MACROS" ]
    }
  }
}

source_set("resource_loader_embedder") {
  sources = [
    "resource_loader_embedder.cc",
    "resource_loader_embedder.h",
  ]
  deps = [
    "../fml:fml",
    "../ui:ui",
  ]
  public_configs = [
    "../../clay:config",
    "../../core:lynx_public_config",
    "../../platform/embedder:public_api",
  ]
}

source_set("lynx_adaptor") {
  sources = [
    "base_def.h",
    "clay_value.cc",
    "clay_value.h",
    "layout_context_clay.cc",
    "layout_context_clay.h",
    "lynx_event_dispatcher.cc",
    "lynx_event_dispatcher.h",
    "painting_context_clay.cc",
    "painting_context_clay.h",
    "perf_controller_clay.cc",
    "perf_controller_clay.h",
    "platform_extra_bundle_clay.h",
    "platform_node_tag_resolver.h",
    "prop_bundle_impl.cc",
    "prop_bundle_impl.h",
    "ui_delegate_clay.cc",
    "ui_delegate_clay.h",
    "value_converter.cc",
    "value_converter.h",
    "video_engine_tag_priority.h",
  ]
  sources += rebase_path(clay_native_module_sources, "", "native_module")

  # lynx_websocket_module.cc requires boringssl
  include_dirs = [ "//third_party/boringssl/src/include" ]

  public_configs = [
    "../../clay:config",
    "../../core:lynx_public_config",
    "../../platform/embedder:public_api",
  ]

  public_deps = [
    "../fml:fml",
    "../ui:ui",
  ]
  if (use_clay_lynx_trail_hub_impl) {
    public_deps += [ ":lynx_trail_hub_impl_clay" ]
  }

  if (is_win || is_mac || (is_linux && is_headless) ||
      (is_harmony && is_headless)) {
    sources += [
      "native_view_service_embedder.cc",
      "native_view_service_embedder.h",
    ]
    if (enable_unittests) {
      sources += [ "native_platform_view_mock.cc" ]
    } else {
      sources += [ "native_platform_view.cc" ]
    }
    include_dirs += [ "../../base/include/value" ]
    public_deps += [
      ":resource_loader_embedder",
      "../../base/src:base_values",
    ]
  }

  defines = []
  if (is_mac || is_android || is_ios) {
    defines += [ "TRACE_EVENT_HIDE_MACROS" ]
  }
}

source_set("lynx_trail_hub_impl_clay") {
  sources = [
    "lynx_trail_hub_impl_clay.cc",
    "lynx_trail_hub_impl_clay.h",
  ]

  public_configs = [ "../../clay:config" ]

  deps = [ "../../platform/embedder/lynx_service:lynx_service" ]
}
