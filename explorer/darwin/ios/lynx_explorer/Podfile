source 'https://cdn.cocoapods.org/'
project './LynxExplorer.xcodeproj'

lynx_root = File.expand_path('../../../..', __dir__)
lynx_library_plugin_dir = File.join(lynx_root, 'tools/ios_tools/cocoapods-lynx-library/lib')
$LOAD_PATH.unshift lynx_library_plugin_dir
load File.join(lynx_library_plugin_dir, 'cocoapods_plugin.rb')
load File.join(__dir__, 'scripts/generate_sparkling_podspecs.rb')

platform :ios, '12.0'

def parse_sparkling_ios_flag(value)
  return nil if value.nil? || value.empty?

  case value.downcase
  when '1', 'true', 'yes'
    true
  when '0', 'false', 'no'
    false
  else
    raise Pod::Informative, 'ENABLE_SPARKLING_IOS must be 1 or 0'
  end
end

def xcconfig_tokens(value)
  value.to_s.split(/\s+/).reject(&:empty?)
end

def remove_xcconfig_token(xcconfig, key, token)
  tokens = xcconfig_tokens(xcconfig.attributes[key])
  tokens.delete(token)
  xcconfig.attributes[key] = tokens.empty? ? '$(inherited)' : tokens.join(' ')
end

def add_xcconfig_token(xcconfig, key, token)
  tokens = xcconfig_tokens(xcconfig.attributes[key])
  tokens << '$(inherited)' if tokens.empty?
  tokens << token unless tokens.include?(token)
  xcconfig.attributes[key] = tokens.join(' ')
end

sparkling_pod_names = ['Sparkling', 'SparklingMethod', 'Sparkling-Router']
sparkling_output_dir = File.join(__dir__, 'generated/sparkling-podspecs')
sparkling_flag = parse_sparkling_ios_flag(ENV['ENABLE_SPARKLING_IOS'])
sparkling_missing = SparklingPodspecOverlays.missing_requirements(
  :lynx_root => lynx_root,
  :pod_names => sparkling_pod_names
)

enable_sparkling_ios = if sparkling_flag.nil?
  !ENV['GITHUB_ACTIONS'] && sparkling_missing.empty?
else
  sparkling_flag
end

if enable_sparkling_ios && !sparkling_missing.empty?
  raise Pod::Informative, "ENABLE_SPARKLING_IOS=1 requires installed Sparkling packages:\n  - #{sparkling_missing.join("\n  - ")}"
end

install!'cocoapods',:deterministic_uuids=>false,
                    :lock_pod_sources=>false,
                    :generate_multiple_pod_projects => true,
                    :incremental_installation=>true,
                    :warn_for_multiple_pod_sources => false

post_install do |installer|
  installer.pod_target_subprojects.flat_map { |p| p.targets }.each do |t|
    t.build_configurations.each do |c|
      c.build_settings['CODE_SIGNING_ALLOWED'] = "NO"
    end
  end

  installer.aggregate_targets.each do |aggregate_target|
    next unless aggregate_target.name == 'Pods-LynxExplorer'

    aggregate_target.xcconfigs.each do |_configuration, xcconfig|
      remove_xcconfig_token(xcconfig, 'GCC_PREPROCESSOR_DEFINITIONS', 'HAS_SPARKLING=1')
      remove_xcconfig_token(xcconfig, 'SWIFT_ACTIVE_COMPILATION_CONDITIONS', 'HAS_SPARKLING')
      if enable_sparkling_ios
        add_xcconfig_token(xcconfig, 'GCC_PREPROCESSOR_DEFINITIONS', 'HAS_SPARKLING=1')
        add_xcconfig_token(xcconfig, 'SWIFT_ACTIVE_COMPILATION_CONDITIONS', 'HAS_SPARKLING')
      end
      xcconfig.save_as(aggregate_target.xcconfig_path(_configuration))
    end
  end
end

target 'LynxExplorer' do
  use_frameworks! :linkage => :static
  pod 'Lynx', :path => '../../../..', :subspecs => [
   'Framework',
  ],:testspecs => [ 'UnitTests' ]

  pod 'LynxBase', :path => '../../../..', :subspecs => [
   'Framework',
  ]

  pod 'LynxDevtool', :path => '../../../..', :subspecs => [
   'Framework',
   'LynxRecorder',
  ],:testspecs => [ 'UnitTests' ]

  pod 'BaseDevtool', :path => '../../../..'

  pod 'LynxService', :path => '../../../..', :subspecs => [
    'Image',
    'Log',
    'Devtool',
    'Http',
  ]
  pod 'LynxServiceAPI', :path => '../../../..', :subspecs => [
    'Core'
  ]

  use_lynx_library!(
    :root => __dir__,
    :output_dir => File.join(__dir__, 'generated/lynx-library')
  )

  pod 'AnimaX', '1.0.1-alpha.13', :subspecs => [
    'Core',
    'Framework',
    'Textra',
    'RenderBackend/Skity',
  ]
  pod 'skity', '1.1.0-alpha.3'
  pod 'LynxTextra', '0.1.5'

  pod 'XElement', :path => '../../../..', :subspecs => [
    'AnimaX',
    'Behavior',
  ]

  pod 'PrimJS', '4.2.0-alpha.0', :subspecs => ['quickjs', 'napi']
  pod 'LynxWeakNodeAPI', '0.0.6', :subspecs => ['core', 'primjs_bridge']
  if ENV['LYNX_NODE_API_ADDON_POD_PATH'] && ENV['LYNX_NODE_API_ADDON_POD_NAME']
    pod ENV['LYNX_NODE_API_ADDON_POD_NAME'], :path => ENV['LYNX_NODE_API_ADDON_POD_PATH']
  end

  pod 'SDWebImage','5.15.5'
  pod 'SDWebImageWebPCoder', '0.11.0'

  pod 'DebugRouter', '5.0.15'
  pod 'DebugRouter/MessageTransceiverEnable', '5.0.15'
  pod 'MJRefresh', '3.6.1'

  # Sparkling SDK — pods sourced from generated local podspec overlays with
  # symlinks back to npm package sources. Requires Swift 5.10+ (Xcode 15.3+),
  # so OSS CI keeps it disabled with ENABLE_SPARKLING_IOS=0 until the CI
  # toolchain is updated.
  if enable_sparkling_ios
    sparkling_pods = SparklingPodspecOverlays.generate!(
      :lynx_root => lynx_root,
      :output_dir => sparkling_output_dir,
      :pod_names => sparkling_pod_names
    )

    pod 'Sparkling/Utils', :path => sparkling_pods['Sparkling']
    pod 'SparklingMethod', :path => sparkling_pods['SparklingMethod'],
        :subspecs => ['Lynx', 'DIProvider', 'Debug']
    pod 'Sparkling-Router', :path => sparkling_pods['Sparkling-Router']
  end
end

target 'LynxExplorerTests' do
  inherit! :complete
  pod 'OCMock', :git => 'https://github.com/erikdoe/ocmock.git', :tag => 'v3.9.1'
  pod 'XcodeCoverage', :git => 'https://github.com/jonreid/XcodeCoverage.git', :tag => 'v1.4.0'
end
