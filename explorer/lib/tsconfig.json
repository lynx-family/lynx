{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "types": ["@lynx-js/types", "vitest/globals"]
  },
  "include": [
    "extensions.ts",
    "extensions.test.ts",
    "navigation.ts",
    "navigation.test.ts",
    "recentHistory.ts"
  ],
  "exclude": ["node_modules"]
}
