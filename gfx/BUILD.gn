import("../config.gni")
import("../testing/test.gni")
import("animation/animation.gni")
import("geometry/geometry.gni")

gfx_public_headers =
    [ "gfx_export.h" ] + gfx_animation_headers + gfx_geometry_headers

gfx_source_files = gfx_animation_sources + gfx_geometry_sources

gfx_builds_shared_library = (is_android || is_harmony) && !is_headless

gfx_public_deps = [ "../base/src:base_log_headers" ]

animation_capability_generator =
    "animation/capabilities/generate_animation_capabilities.py"
ios_animation_capability_json = "animation/capabilities/ios.json"
ios_animation_capability_header =
    "animation/capabilities/ios_animation_capabilities_generated.h"
exec_script(animation_capability_generator,
            [
              "--input",
              rebase_path(ios_animation_capability_json),
              "--output",
              rebase_path(ios_animation_capability_header),
            ],
            "",
            [
              animation_capability_generator,
              ios_animation_capability_json,
            ])

config("gfx_public_config") {
  include_dirs = [ ".." ]
}

config("gfx_no_export_config") {
  defines = [ "GFX_NO_EXPORT" ]
}

source_set("gfx_headers") {
  sources = gfx_public_headers
  public_configs = [ ":gfx_public_config" ]
  public_deps = gfx_public_deps
}

source_set("gfx_sources") {
  visibility = [ "*" ]
  sources = gfx_public_headers + gfx_source_files
  public_configs = [ ":gfx_public_config" ]
  public_deps = gfx_public_deps
  if (!gfx_builds_shared_library) {
    public_configs += [ ":gfx_no_export_config" ]
  }
}

if (gfx_builds_shared_library) {
  group("gfx") {
    public_deps = [ ":gfx_headers" ]
  }
} else {
  group("gfx") {
    public_deps = [ ":gfx_sources" ]
  }
}

unittest_exec("animation_keyframe_unittests_exec") {
  sources = [
    "animation/animation_keyframe_unittest.cc",
    "animation/capabilities/ios_animation_capabilities_unittest.cc",
  ]
  deps = [
    ":gfx_sources",
    "//third_party/googletest:gtest",
  ]
}

unittest_exec("geometry_unittests_exec") {
  sources = [
    "geometry/quaternion_unittest.cc",
    "geometry/transform_operation_unittest.cc",
    "geometry/transform_operations_unittest.cc",
  ]
  deps = [
    ":gfx_sources",
    "//third_party/googletest:gtest",
  ]
}
