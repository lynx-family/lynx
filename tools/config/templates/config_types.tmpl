/**
 * The Lynx config to set.
 *
 * @public
 */

export interface Config {
{% for config in configs %}
{% if not config.deprecated and (not export or (export and config.export))%}
  /**
   {% if config.desc %}
   * {{ config.desc }}
   *
   {% endif %}
   {% if config.platform_tags %}
   {% for tag in config.platform_tags %}
   * {{ tag }}
   {% endfor %}
   {% endif %}
   {% if config.since %}
   *
   * Since: LynxSDK {{ config.since }}
   {% endif %}
   *
   {% if config.js_default_value %}
   * @defaultValue {{ config.js_default_value }}
   {% endif %}
   */
  {{ config.name }}?: {{ config.js_value_type }}

{% endif %}
{% endfor %}
}
